[TEMPLATE]
# ---------------------------------------------------------------------------
# Client-visible values. Anything prefixed VITE_ is inlined into the browser
# bundle at build time, so NEVER put a secret here.
# ---------------------------------------------------------------------------

# Convex deployment URL - replace with your actual deployment URL.
# Run 'npx convex dev' to get the development URL.
# The production Docker build requires this as a --build-arg.
VITE_CONVEX_URL=

# Convex site URL for auth
CONVEX_SITE_URL=http://localhost:5173

# Deployment used by `npx convex dev`
CONVEX_DEPLOYMENT=

# ---------------------------------------------------------------------------
# Convex server-side variables (set with `npx convex env set KEY value`).
# These are read inside actions and are never sent to the browser.
# ---------------------------------------------------------------------------

# Public URL of this deployment, used for auth redirects and "am I local?".
SITE_URL=http://localhost:5173

# --- Email OTP relay -------------------------------------------------------
# Sign-in codes are now sent with Resend's Email API.
#   RESEND_API_KEY      your Resend API key (Bearer auth)
#   RESEND_FROM_EMAIL   a verified From address, e.g. "VerveFit <onboarding@yourdomain.com>"
# Rotate RESEND_API_KEY whenever it may have been exposed in a commit.
RESEND_API_KEY=
RESEND_FROM_EMAIL=VerveFit <onboarding@yourdomain.com>
VLY_APP_NAME=VerveFit

# --- AI coach: layer 3, strong reasoning (required for chat) ---------------
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-flash

# --- AI coach: layer 2, free lightweight model (optional) -----------------
# When unset, lightweight questions are served by the DeepSeek provider.
FREE_AI_API_KEY=
FREE_AI_BASE_URL=
FREE_AI_MODEL=Qwen3-4B-Instruct-2507

# --- Archil persistent disk (serverless exec) ------------------------------
# Create an API key at https://console.archil.com and set it in your .env or
# secret store. Never commit a real key or hardcode it in source.
# Serverless exec is AWS-only today: use aws-us-east-1, aws-us-west-2 or
# aws-eu-west-1, closest to where the compute runs.
ARCHIL_API_KEY=
ARCHIL_REGION=aws-us-east-1
